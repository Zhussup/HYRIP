#!/usr/bin/env bash
# hyrip CLI launcher — `hyrip-cli` (paste mode) or any subcommand, e.g. `hyrip-cli file a.txt`.
# The whole engine/backend runs in this process; there is no server to start.
#
# Reads the API key from ~/.config/hyrip/ollama_key (never from the repo).
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SELF")/.." && pwd)"

if [ -z "${OLLAMA_API_KEY:-}" ] && [ -r "$HOME/.config/hyrip/ollama_key" ]; then
    OLLAMA_API_KEY="$(tr -d ' \t\r\n' < "$HOME/.config/hyrip/ollama_key")"
    export OLLAMA_API_KEY
fi

PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || { echo "hyrip venv missing at $ROOT/.venv — run: python3 -m venv $ROOT/.venv && $ROOT/.venv/bin/pip install -e '$ROOT[web,qt,dev]'" >&2; exit 1; }

[ $# -eq 0 ] && set -- read   # bare command -> paste an article
exec "$PY" -m hyrip "$@"